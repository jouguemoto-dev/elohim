rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Member Validation
    function isValidMember(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 256 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32 &&
             (!('attachments' in data) || (data.attachments is list));
    }

    // Event Validation
    function isValidEvent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
             data.type is string && data.type.size() > 0 &&
             data.publicId is string && data.publicId.size() > 0 &&
             (!('imageUrl' in data) || (data.imageUrl is string)) &&
             (!('attachments' in data) || (data.attachments is list)) &&
             (!('description' in data) || (data.description is string)) &&
             (!('location' in data) || (data.location is string)) &&
             (!('email' in data) || (data.email is string)) &&
             (!('price' in data) || (data.price is number));
    }

    // Registration Validation
    function isValidRegistration(data) {
      return data.eventId is string && data.eventId.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() > 0 &&
             data.status in ['pending', 'paid'] &&
             (!('isMember' in data) || data.isMember is bool) &&
             (!('cpf' in data) || data.cpf is string) &&
             (!('email' in data) || data.email is string) &&
             (!('address' in data) || data.address is string) &&
             (!('birthDate' in data) || data.birthDate is string) &&
             (!('isMinor' in data) || data.isMinor is bool) &&
             (!('amountPaid' in data) || data.amountPaid is number) &&
             (!('registeredAt' in data) || data.registeredAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is string) &&
             (!('memberId' in data) || data.memberId is string) &&
             (!('bloodType' in data) || data.bloodType is string) &&
             (!('allergies' in data) || data.allergies is string) &&
             (!('medications' in data) || data.medications is string) &&
             (!('observations' in data) || data.observations is string) &&
             (!('emergencyContacts' in data) || data.emergencyContacts is map) &&
             (!('guardianAuthorization' in data) || data.guardianAuthorization is map);
    }

    // Settings Validation
    function isValidSettings(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    // Event Type Validation
    function isValidEventType(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    // Event Template Validation
    function isValidEventTemplate(data) {
      return data.name is string && data.name.size() > 0 &&
             data.title is string && data.title.size() > 0 &&
             data.type is string &&
             data.createdAt is string;
    }

    function isValidAccessRequest(data) {
      return data.email is string && data.email.size() > 0 &&
             data.name is string && data.status in ['pending', 'approved', 'denied'] &&
             data.requestedAt is string;
    }

    function isMasterAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             request.auth.token.email.toLower() == 'jouguemoto@gmail.com';
    }

    function isApprovedAdmin() {
      return isSignedIn() && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/access_requests/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.status == 'approved')
      );
    }

    // Config Collection
    match /config/church {
      allow read: if true;
      allow write: if isApprovedAdmin() && isValidSettings(request.resource.data);
    }

    // Event Types Collection
    match /eventTypes/{typeId} {
      allow read: if true;
      allow write: if isApprovedAdmin() && isValidEventType(request.resource.data);
      allow delete: if isApprovedAdmin();
    }

    // Members Collection
    match /members/{memberId} {
      allow read, write: if isApprovedAdmin();
      allow create: if isApprovedAdmin() && isValidId(memberId) && isValidMember(request.resource.data);
      allow update: if isApprovedAdmin() && isValidMember(request.resource.data);
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true; // Publicly readable for dynamic forms
      allow write: if isApprovedAdmin();
      allow create: if isApprovedAdmin() && isValidId(eventId) && isValidEvent(request.resource.data);
      allow update: if isApprovedAdmin() && isValidEvent(request.resource.data);
    }

    // Registrations Collection
    match /registrations/{registrationId} {
      allow create: if isValidRegistration(request.resource.data); // Public registration
      allow read, update, delete: if isApprovedAdmin(); // Admin only management
      allow list: if isApprovedAdmin();
    }

    // Event Templates Collection
    match /eventTemplates/{templateId} {
      allow read, write: if isApprovedAdmin();
      allow create: if isApprovedAdmin() && isValidEventTemplate(request.resource.data);
      allow update: if isApprovedAdmin() && isValidEventTemplate(request.resource.data);
    }

    // Access Requests Collection
    match /access_requests/{requestId} {
      allow create: if isSignedIn() && requestId == request.auth.uid && isValidAccessRequest(request.resource.data);
      allow read: if isSignedIn() && (requestId == request.auth.uid || isMasterAdmin());
      allow update, delete: if isMasterAdmin();
      allow list: if isMasterAdmin() || (isSignedIn() && request.query.limit <= 1);
    }
  }
}
